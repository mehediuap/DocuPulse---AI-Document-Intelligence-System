{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint .",
    "test": "npx tsx scripts/run-tests.ts",
    "evaluate": "npx tsx scripts/evaluate-system.ts",
    "evaluate:gemini": "npx tsx scripts/evaluate-system.ts --mode=gemini",
    "evaluate:v2": "npx tsx scripts/evaluate-v2.ts",
    "dataset:independent": "python evaluation/generate_realistic_dataset.py",
    "evaluate:independent": "npx tsx scripts/evaluate-system.ts --dataset=evaluation/dataset_independent --ground-truth=evaluation/ground_truth_independent.json --output=docs/evaluation_metrics_independent.json --report=docs/evaluation_report_independent.md"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
