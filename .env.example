# GEMINI_API_KEY: Required for Gemini API key authentication. Keep this value private.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Google Cloud project metadata. Project number is informational; the GenAI SDK
# uses GOOGLE_PROJECT_ID when Vertex AI authentication is enabled.
GOOGLE_PROJECT_ID="gen-lang-client-0631189617"
GOOGLE_PROJECT_NUMBER="875867557568"

# Set to "true" to use Vertex AI with Application Default Credentials instead
# of a Gemini API key. GOOGLE_CLOUD_LOCATION defaults to us-central1.
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_LOCATION="us-central1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXTRACTION_MODE: "mock" (deterministic rule-based, no API needed) or "gemini" (LLM extraction via @google/genai; requires an API key or Vertex AI configuration)
EXTRACTION_MODE="mock"

# GEMINI_MODEL: Model alias for extraction (default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# EXTRACTION_TIMEOUT_MS: Maximum allowed time in milliseconds for extraction calls
EXTRACTION_TIMEOUT_MS="30000"

# OCR_PROVIDER: "auto" uses Gemini when configured, then Tesseract for raster images;
# "gemini" requires Gemini/Vertex credentials; "tesseract" forces local image OCR;
# "mock" disables OCR for deterministic offline tests.
OCR_PROVIDER="auto"
GEMINI_OCR_MODEL="gemini-3.1-flash-lite"

# Optional paths for self-hosted Tesseract worker, core, language data, and cache.
# Set these in production to avoid downloading OCR assets at runtime.
TESSERACT_LANG_PATH=""
TESSERACT_WORKER_PATH=""
TESSERACT_CORE_PATH=""
TESSERACT_CACHE_PATH=""

# Optional JSON object mapping long random bearer tokens to actor IDs.
# Example shape: {"<random-token-of-at-least-32-characters>":"finance-reviewer"}
# Configure this in production; an empty registry blocks document APIs in production.
DOCUPULSE_API_TOKENS=""

# Optional directory for atomically persisted source documents; defaults to data/uploads.
DOCUPULSE_UPLOAD_DIR=""

# The frontend API token is entered at runtime in the dashboard and kept in session storage.
# Do not place API tokens in VITE_* variables because they are embedded into the browser bundle.

# ENABLE_SENSITIVE_LOGGING: Set to "true" only in isolated debug environments. Default "false" protects invoice contents.
ENABLE_SENSITIVE_LOGGING="false"

# VITE_API_BASE_URL: Base URL for frontend REST API calls. Leave empty for same-origin (/api/v1).
VITE_API_BASE_URL=""
